[Unit]
Description=FitTrack PostgreSQL backup to Cloudflare R2
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=atlas
Group=atlas
Environment=PATH=/home/atlas/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=FITTRACK_ENV_FILE=/home/atlas/apps/fittrack/fittrack.env
Environment=FITTRACK_RCLONE_REMOTE=r2
Environment=FITTRACK_R2_BUCKET=fittrack-backups
Environment=FITTRACK_BACKUP_DIR=/opt/fittrack/backups/postgres
Environment=FITTRACK_LOCAL_RETENTION_DAYS=14
Environment=FITTRACK_R2_RETENTION_DAYS=90
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ExecStart=/usr/bin/python3 /home/atlas/apps/fittrack/scripts/postgres_backup.py backup
