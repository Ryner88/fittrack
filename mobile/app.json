{
  "expo": {
    "name": "FitTrack",
    "slug": "fittrack-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "fittrack",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fittrack.mobile"
    },
    "android": {
      "package": "com.fittrack.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#0f172a"
      }
    },
    "extra": {
      "apiBaseUrl": "http://localhost:4000/api/v1"
    }
  }
}
